  <string id="id_ui_howtoplay_goal_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[The%20game%20consists%20of%2013%20rounds.%20In%20each%20round%2C%20you%20roll%20the%20dice%20and%20then%20score%20the%20roll%20in%20one%20of%2013%20categories.%20You%20must%20score%20once%20in%20each%20category%20--%20which%20means%20that%20you%20may%20have%20to%20settle%20for%20scoring%20a%20zero%20in%20some%20categories%20if%20you%27re%20unable%20to%20roll%20qualifying%20combinations.]]></string>
  <string id="id_ui_howtoplay_goal_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[The%20object%20of%20the%20game%20is%20to%20maximize%20your%20total%20score.%20The%20game%20ends%20once%20all%2013%20categories%20have%20been%20scored.]]></string>
  <string id="id_ui_howtoplay_goal_Title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[%3Ci%3E%3Cb%3EGOAL%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_roll_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[%3Ci%3E%3Cb%3EROLLING%20THE%20DICE%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_roll_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Roll%20all%20five%20dice%20by%20clicking%20on%20the%20cup%20on%20the%20right%20side%20of%20the%20screen%20or%20the%20Roll%20button%20below.%20After%20you%20roll%20the%20dice%2C%20you%20can%20either%20score%20the%20current%20roll%20or%20re-roll%20any%20or%20all%20of%20the%20five%20dice.]]></string>
  <string id="id_ui_howtoplay_roll_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[To%20re-roll%20some%20of%20the%20dice%2C%20first%20click%20on%20the%20dice%20you%20would%20like%20to%20keep%20and%20then%20click%20again%20on%20the%20cup%20or%20Roll%20button.%20This%20will%20re-roll%20the%20unselected%20dice%2C%20leaving%20the%20selected%20ones%20unchanged.]]></string>
  <string id="id_ui_howtoplay_roll_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[You%20can%20roll%20the%20dice%20a%20maximum%20of%203%20times%20per%20round.%20]]></string>
  <string id="id_ui_howtoplay_tips_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[%3Ci%3E%3Cb%3ETIPS%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_tips_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Try%20to%20fill%20in%20high%20point%20categories%20%28lower%20score%20card%29%20early%20on%20in%20the%20game.%20Getting%205%20aces%20early%20would%20be%20better%20spent%20on%20a%20YAHTZEE%20%2850%20points%29%20than%20scoring%20it%20in%20Aces%20%28only%205%20points%29.%20Remember%20that%20you%20can%20use%20Chance%2C%20Aces%20or%20Deuces%20to%20score%20a%20bad%20roll%20and%20recover%20later.]]></string>
  <string id="id_ui_howtoplay_tips_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[It%20can%20be%20advantageous%20to%20score%20four%20of%20a%20kind%20in%20the%20upper%20half%20of%20your%20score%20card%20if%20you%20roll%204%27s%2C%205%27s%20or%206%27s%20due%20to%20the%2035%20points%20bonus%20for%20scoring%2063%20or%20more%20points%20in%20the%20upper%20score%20card.]]></string>
  <string id="id_ui_howtoplay_tips_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Go%20for%20the%20Long%20Straight%20if%20you%20hit%20a%20Short%20Staight%20on%20your%20first%20roll%20and%20only%20need%20a%201%20or%206%20to%20complete%20it.%20The%20odds%20of%20rolling%20a%201%20or%206%20in%20your%20following%20two%20rolls%20are%20higher%20than%20you%20think%21]]></string>
