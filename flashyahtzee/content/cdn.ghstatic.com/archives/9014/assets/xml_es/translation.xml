  <string id="id_ui_title_tooltip_copyright" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="0" catID="1"><![CDATA[<b>YAHTZEE es una marca registrada de Hasbro y se usa con licencia. ©2011 Hasbro. Todos los derechos reservados.</b>]]></string>
  <string id="id_ui_hud_display_name2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="5"><![CDATA[<b><i>$value$</i></b>]]></string>
  <string id="id_popup_tutorial_desc_Round3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>¡Parece que estás cogiéndole el truco!<br><br>Sigue tirando e intenta conseguir la máxima puntuación, no solo en cada ronda sino en todo el juego.</b>]]></string>
  <string id="id_popup_tutorial_desc_BonusYahtzee" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>¡Has conseguido un Bonus YAHTZEE!<br><br>Por cada YAHTZEE que hagas después del primero, ¡recibes un bonus de 100 puntos! Además, si la categoría de la sección superior correspondiente ya está llena, puedes usar esta tirada como comodín en cualquiera de las categorías de la sección inferior.</b>]]></string>
  <string id="id_ui_hud_display_categoryBonus" fontName="fntCalibri" fontSize="11" charSpace="0" lineSpace="0" catID="5"><![CDATA[<b>+$value$</b>]]></string>
