  <string id="id_popup_tutorial_desc_Tournament" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>¡Te damos la bienvenida al Torneo de YAHTZEE!<br>En este prestigioso evento, te enfrentarás a una serie de oponentes para ganarte el derecho a enfrentarte al campeón.<br><br>¡Usa todo tu ingenio y tu poder para triunfar con todo en contra! ¡Buena suerte!</b>]]></string>
  <string id="id_popup_tutorial_desc_ViewOpponent" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Ahora que ha terminado una ronda, puedes ver la tarjeta de puntos de tu oponente.<br><br>Mueve el ratón sobre el nombre de un oponente para ver su tarjeta de puntos.</b>]]></string>
  <string id="id_popup_enter_name_error_nameUsed" fontName="fntCalibri" fontSize="18" charSpace="0" lineSpace="0" catID="13"><![CDATA[Alguien ya usa ese nombre.]]></string>
