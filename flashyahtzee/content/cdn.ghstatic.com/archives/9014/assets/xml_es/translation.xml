  <string id="id_ui_popup_feedback_WinSolo_text" fontName="fntHoboStd" fontSize="30" charSpace="0" lineSpace="0" catID="12"><![CDATA[<i><b>¡Buena partida!</b></i>]]></string>
  <string id="id_ui_endgame_title_WinSolo_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>¡Qué puntuación!</i>]]></string>
  <string id="id_ui_endgame_title_WinSolo_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>¡Intenta superarla la próxima vez!</i>]]></string>
  <string id="id_popup_tutorial_desc_WildDie" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>¡Has conseguido un Dado Comodín!<br><br>Estos dados pueden ser el número que quieras. Asegúrate de conservarlo junto con los demás dados que quieras usar al elegir la categoría en la que puntúas.</b>]]></string>
