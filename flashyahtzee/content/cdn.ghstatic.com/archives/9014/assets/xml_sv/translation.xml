  <string id="id_ui_endgame_title_WinSolo_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Suverän poäng!</i>]]></string>
  <string id="id_ui_endgame_title_WinSolo_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Försök få högre nästa gång!</i>]]></string>
  <string id="id_popup_tutorial_desc_WildDie" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Du fick en jokertärning!<br><br>Jokertärningar kan ersätta vilken siffra du vill. Se till att behålla den och alla andra andra tärningar du vill använda när du klickar på en kategori att sätta poäng i.</b>]]></string>
