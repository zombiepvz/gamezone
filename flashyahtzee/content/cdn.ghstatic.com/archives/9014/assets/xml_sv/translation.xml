  <string id="id_ui_title_tooltip_copyright" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="0" catID="1"><![CDATA[<b>YAHTZEE/YAHTZEE är varumärken tillhörande Hasbro och används med deras tillstånd. ©2011 Hasbro. Alla rättigheter förbehållna.</b>]]></string>
  <string id="id_ui_hud_display_name2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="5"><![CDATA[<b><i>$value$</i></b>]]></string>
  <string id="id_popup_tutorial_desc_Round3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Du verkar förstå hur det fungerar nu!<br><br>Fortsätt slå och försök få högsta möjliga poäng - inte bara i varje runda, utan totalt igenom hela spelet.</b>]]></string>
  <string id="id_popup_tutorial_desc_BonusYahtzee" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Du fick precis en bonus-YAHTZEE!<br><br>För varje extra YAHTZEE du slår, får du 100 bonuspoäng! Dessutom kan du, om motsvarande kategori i övre delen redan är ifylld, använda det här slaget som joker och fylla i vilken som helst av kategorierna i nedre delen.</b>]]></string>
