  <string id="id_popup_enter_name_title" fontName="fntHoboStd" fontSize="17" charSpace="0" lineSpace="0" catID="13"><![CDATA[<i><b>Skriv in ditt namn</b></i>]]></string>
  <string id="id_popup_tutorial_desc_Tournament" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Välkommen till YAHTZEE-turneringen!<br>I denna prestigefyllda tävling kommer du att möta en serie motståndare för att få chansen att möta den nuvarande mästaren.<br><br>Använd all din skicklighet och list för att vinna mot alla odds! Lycka till!</b>]]></string>
  <string id="id_popup_tutorial_desc_ViewOpponent" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Nu när rundan är över, kan du ta en titt på din motståndares poängkort.<br><br>Rulla över en motståndares namnbricka ovan för att se poängkortet.</b>]]></string>
  <string id="id_popup_enter_name_error_nameUsed" fontName="fntCalibri" fontSize="18" charSpace="0" lineSpace="0" catID="13"><![CDATA[Det namnet finns redan.]]></string>
