  <string id="id_ui_title_tooltip_classic" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Njut av klassisk YAHTZEE-action!</i>]]></string>
  <string id="id_ui_title_tooltip_tournament" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Klättra på turneringsstegen</i>]]></string>
  <string id="id_ui_title_tooltip_superyahtzee" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Spela SuperYAHTZEE-läget</i>]]></string>
  <string id="id_ui_title_tooltip_options" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Ändra dina spelinställningar</i>]]></string>
  <string id="id_ui_howtoplay_goal_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Spelet består av 13 rundor. I varje runda slår du tärningen och placerar sedan slagets poäng i en av 13 kategorier. Du måste sätta poäng i varje kategori -- vilket betyder att du kanske får finna dig i att sätta en nolla i vissa kategorier om du inte kan slå kombinationer som passar. Klicka på slå-knappen eller tärningsbägaren nedan för att slå.]]></string>
  <string id="id_ui_howtoplay_goal_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Spelets mål är att få högsta möjliga totalpoäng. Spelet är slut när poäng har satts i alla 13 kategorier.]]></string>
  <string id="id_ui_howtoplay_goal_Title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>MÅL</b></i>]]></string>
  <string id="id_ui_howtoplay_roll_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>SLÅ TÄRNINGEN</b></i>]]></string>
  <string id="id_ui_howtoplay_roll_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Slå tärningen genom att klicka på bägaren till höger på skärmen, eller slå-knappen nedan. När du slagit tärningen kan du antingen ta poängen från slaget eller slå om en eller flera av tärningarna.]]></string>
  <string id="id_ui_howtoplay_roll_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[För att slå om vissa tärningar, klickar du på de tärningar du vill behålla och klickar sedan på bägaren eller slå-knappen igen. Detta slår om de icke valda tärninarna, utan att förändra de valda.]]></string>
  <string id="id_ui_howtoplay_roll_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Du kan slå tärningarna max 3 gånger per runda.]]></string>
  <string id="id_ui_howtoplay_tips_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>TIPS</b></i>]]></string>
  <string id="id_ui_howtoplay_tips_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Försök fylla i de högre poängkategorierna (längre ner på kortet) tidigt i spelet. Fem tidiga ettor är bättre placerade som YAHTZEE (50 poäng) än som Ettor (bara 5 poäng). Kom ihåg att du kan använda Chans, Ettor eller Tvåor för att bli av med ett dåligt kast och komma igen senare.]]></string>
  <string id="id_ui_howtoplay_tips_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Det kan vara fördelaktigt att placera ett fyrtal på övre delen av poängkortet om du får 4:or, 5:or eller 6:or, på grund av 35-poängsbonusen, om du får 63 poäng eller mer i övre delen av kortet.]]></string>
  <string id="id_ui_howtoplay_tips_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Satsa på Stor stege om du får en Liten stege på första slaget och bara behöver 1 eller 6 för att klara den. Oddsen för att slå 1 eller 6 med dina två kvarvarande slag är bättre än du tror!]]></string>
  <string id="id_ui_howtoplay_tips_text4" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Satsa på YAHTZEE, men se till att du har motsvarande kategori på övre delen som utväg om du inte klarar det. Försök att undvika att sätta 0 poäng på YAHTZEE!]]></string>
  <string id="id_ui_howtoplay_tips_text5" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Den bästa kategorin på kortet är Chans -- Försök behålla den så länge du kan för att ta hand om de oundvikliga dåliga slagen. Om inte annat kan du använda den för att slippa en nolla i högre poängkategorier, som Stor stege och YAHTZEE.]]></string>
  <string id="id_ui_endgame_title_Win_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Fantastisk match!</i>]]></string>
  <string id="id_ui_endgame_title_Win_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Du vann!</i>]]></string>
  <string id="id_ui_endgame_title_WinChamp_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Gratulerar!</i>]]></string>
  <string id="id_ui_endgame_title_WinChamp_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Du är den nya<br>YAHTZEE-mästaren!</i>]]></string>
  <string id="id_ui_endgame_title_Lose_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Deppa inte, vi</i>]]></string>
  <string id="id_ui_endgame_title_Lose_Line2" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>spelar en match till!</i>]]></string>
  <string id="id_popup_tutorial_desc_Turn2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Om du är nöjd med det här slaget, väljer du en kategori att placera poängen i.<br><br>Om inte, har du ett tredje slag kvar.</b>]]></string>
