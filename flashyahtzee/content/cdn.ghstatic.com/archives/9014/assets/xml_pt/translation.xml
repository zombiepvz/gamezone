  <string id="id_ui_popup_feedback_WinSolo_text" fontName="fntHoboStd" fontSize="30" charSpace="0" lineSpace="0" catID="12"><![CDATA[<i><b>Bom jogo!</b></i>]]></string>
  <string id="id_ui_endgame_title_WinSolo_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Jogada fabulosa!</i>]]></string>
  <string id="id_ui_endgame_title_WinSolo_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Tente melhorar da próxima vez!</i>]]></string>
  <string id="id_popup_tutorial_desc_WildDie" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Você tem um Dado Curinga!<br><br>O Dado Curinga pode ser o número que você quiser. Certifique-se de que o mantenha combinado com quaisquer dados que deseja usar, clicando na categoria desejada para a jogada.</b>]]></string>
