  <string id="id_ui_title_tooltip_classic" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Prova il Classico gioco YAHTZEE!</i>]]></string>
  <string id="id_ui_title_tooltip_tournament" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Scala la classifica del torneo</i>]]></string>
  <string id="id_ui_title_tooltip_superyahtzee" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Gioca la modalità Super YAHTZEE</i>]]></string>
  <string id="id_ui_title_tooltip_options" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Modifica le impostazioni di gioco</i>]]></string>
  <string id="id_ui_howtoplay_goal_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[La partita è composta da 13 round. In ogni round, lanci i dadi e ottieni un punteggio che conteggerai in una delle 13 categorie. Devi segnare un punteggio per ogni categoria, il che significa che in alcune categorie potresti ottenere uno zero, se il tuo lancio non risulta in una combinazione qualificante.]]></string>
  <string id="id_ui_howtoplay_goal_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Lo scopo del gioco è ottenere il punteggio più alto. Il gioco si conclude quando è stato ottenuto un punteggio per ognuna delle 13 categorie.]]></string>
  <string id="id_ui_howtoplay_goal_Title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>OBIETTIVO</b></i>]]></string>
  <string id="id_ui_howtoplay_roll_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>LANCIARE I DADI</b></i>]]></string>
  <string id="id_ui_howtoplay_roll_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Lancia tutti e cinque i dadi facendo clic sul bicchiere sul lato destro dello schermo, o sul pulsante Lancia sottostante. Dopo aver lanciato i dadi, puoi mantenere il punteggio ottenuto oppure lanciare nuovamente tutti o alcuni dei dadi.]]></string>
  <string id="id_ui_howtoplay_roll_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Per lanciare nuovamente alcuni dei dadi, fai prima clic sui dadi che vuoi conservare, quindi nuovamente clic sul bicchiere o sul pulsante Lancia. In questo modo lancerai nuovamente i dadi non selezionati, lasciando gli altri invariati.]]></string>
  <string id="id_ui_howtoplay_roll_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Puoi lanciare i dadi al massimo 3 volte per round. ]]></string>
  <string id="id_ui_howtoplay_tips_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>DRITTE</b></i>]]></string>
  <string id="id_ui_howtoplay_tips_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Cerca di riempire le categorie dal punteggio più alto (parte bassa del segnapunti) all'inizio del gioco. Cinque assi ottenuti all'inizio sarebbero meglio se utilizzati per uno YAHTZEE (50 punti) che per gli Uno (solo 5 punti). Ricorda che puoi usare Chance, Uno o Due per conteggiare un punteggio basso e recuperare in seguito.]]></string>
  <string id="id_ui_howtoplay_tips_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Può essere utile conteggiare 4 dadi uguali nella parte alta del segnapunti se si ottengono 4, 5 o 6, visti i 35 punti bonus quando si totalizzano 63 o più punti nella parte alta del segnapunti.]]></string>
  <string id="id_ui_howtoplay_tips_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Cerca di ottenere una Scala con 5 dadi se ottieni una Scala con 4 dadi al primo lancio e ti servono soltanto un 1 o un 6 per completarla. Le possibilità di lanciare un 1 o un 6 nei due lanci successivi sono più alte di quanto pensi!]]></string>
  <string id="id_ui_howtoplay_tips_text4" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Cerca di ottenere degli YAHTZEE, ma cerca di tenere la categoria corrispondente nella parte superiore vuota, per recuperare se non li ottieni. Evita di segnare uno 0 per YAHTZEE, se puoi!]]></string>
  <string id="id_ui_howtoplay_tips_text5" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[La migliore categoria presente sul segnapunti è Chance, cerca di tenerla libera il più a lungo possibile, per utilizzarla in caso dell'inevitabile lancio cattivo. Se non altro, potrai utilizzarla per evitare uno zero in una delle categorie di valore più alto, come Scala con 5 dadi o YAHTZEE.]]></string>
  <string id="id_ui_endgame_title_Win_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Ottimo match!</i>]]></string>
  <string id="id_ui_endgame_title_Win_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Hai vinto!</i>]]></string>
  <string id="id_ui_endgame_title_WinChamp_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Complimenti!</i>]]></string>
  <string id="id_ui_endgame_title_WinChamp_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Sei il nuovo<br>campione di YAHTZEE!</i>]]></string>
  <string id="id_ui_endgame_title_Lose_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Non arrenderti, giochiamo</i>]]></string>
  <string id="id_ui_endgame_title_Lose_Line2" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>un altro match!</i>]]></string>
  <string id="id_popup_tutorial_desc_Turn2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Se il tuo lancio attuale ti soddisfa, seleziona una categoria in cui conteggiarlo.<br><br>Altrimenti, hai ancora un terzo lancio.</b>]]></string>
  <string id="id_ui_loading_building" fontName="fntCalibri" fontSize="18" charSpace="0" lineSpace="0" catID="0"><![CDATA[Ottimizzazione...$value$]]></string>
  <string id="id_ui_ladder_match_opponentsLabel" fontName="fntHoboStd" fontSize="20" charSpace="0" lineSpace="0" catID="9"><![CDATA[<i><b>Avversari</b></i>]]></string>
  <string id="id_ui_title_tooltip_copyright" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="0" catID="1"><![CDATA[<b>YAHTZEE è un marchio registrato Hasbro e viene usato con il suo permesso. ©2011 Hasbro. Tutti i diritti riservati.</b>]]></string>
  <string id="id_ui_hud_display_name2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="5"><![CDATA[<b><i>$value$</i></b>]]></string>
  <string id="id_popup_tutorial_desc_Round3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Inizi a capire come funziona!<br><br>Continua a lanciare e cerca di ottenere il punteggio più alto possibile, non solo per ogni round, ma in tutta la partita.</b>]]></string>
  <string id="id_popup_tutorial_desc_BonusYahtzee" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Hai appena ottenuto un Bonus YAHTZEE!<br><br>Per ogni YAHTZEE in più lanciato, ottieni 100 punti bonus! Inoltre, se la categoria corrispondente nella parte superiore del segnapunti è già stata riempita, puoi usare questo lancio come jolly per riempire una categoria qualsiasi della parte inferiore.</b>]]></string>
  <string id="id_ui_hud_display_categoryBonus" fontName="fntCalibri" fontSize="11" charSpace="0" lineSpace="0" catID="5"><![CDATA[<b>+$value$</b>]]></string>
