  <string id="id_popup_enter_name_title" fontName="fntHoboStd" fontSize="17" charSpace="0" lineSpace="0" catID="13"><![CDATA[<i><b>Immetti il tuo nome</b></i>]]></string>
  <string id="id_popup_tutorial_desc_Tournament" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Benvenuti al torneo YAHTZEE!<br>In questo prestigioso evento, degli avversari si sfidano per ottenere il diritto ad affrontare il campione in carica.<br><br>Usa tutta la tua astuzia e la tua forza per trionfare, sfidando ogni probabilità! Buona fortuna!</b>]]></string>
  <string id="id_popup_tutorial_desc_ViewOpponent" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Ora che un round è stato completato, puoi dare un'occhiata al segnapunti del tuo avversario.<br><br>Muoviti sopra alla targhetta con il nome di un avversario per vedere il suo segnapunti.</b>]]></string>
  <string id="id_popup_enter_name_error_nameUsed" fontName="fntCalibri" fontSize="18" charSpace="0" lineSpace="0" catID="13"><![CDATA[Questo nome è già in uso.]]></string>
