  <string id="id_ui_endgame_title_WinSolo_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Ottimo punteggio!</i>]]></string>
  <string id="id_ui_endgame_title_WinSolo_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Cerca di fare meglio la prossima volta!</i>]]></string>
  <string id="id_popup_tutorial_desc_WildDie" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Ottieni un Dado jolly!<br><br>Il Dado jolly può sostituire qualsiasi numero desideri. Assicurati di combinarlo con qualsiasi dado vuoi utilizzare quando fai clic su una categoria per conteggiare il tuo lancio.</b>]]></string>
