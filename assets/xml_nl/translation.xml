  <string id="id_ui_title_tooltip_classic" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Geniet van klassieke YAHTZEE-actie!</i>]]></string>
  <string id="id_ui_title_tooltip_tournament" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Klim in het toernooiklassement</i>]]></string>
  <string id="id_ui_title_tooltip_superyahtzee" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Speel SuperYAHTZEE</i>]]></string>
  <string id="id_ui_title_tooltip_options" fontName="fntCalibri" fontSize="12" charSpace="0" lineSpace="0" catID="1"><![CDATA[<i>Pas je spelinstellingen aan</i>]]></string>
  <string id="id_ui_howtoplay_goal_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Het spel bestaat uit 13 rondes. In elke ronde gooi je met de dobbelstenen en noteer je je score in een van de 13 categorieën. Je moet in elke categorie een score invullen. Dat betekent dat je soms een nul moet noteren als je de juiste combinatie niet gooit.]]></string>
  <string id="id_ui_howtoplay_goal_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Het doel van het spel is een zo hoog mogelijke totaalscore te behalen. Het spel is voorbij als alle 13 categorieën zijn ingevuld.]]></string>
  <string id="id_ui_howtoplay_goal_Title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>DOEL</b></i>]]></string>
  <string id="id_ui_howtoplay_roll_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>GOOIEN MET DE DOBBELSTENEN</b></i>]]></string>
  <string id="id_ui_howtoplay_roll_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Gooi met alle 5 de dobbelstenen door rechts in het scherm op de beker, of hieronder op de Gooien-knop te klikken. Als je gegooid hebt, kun je je score noteren of kiezen welke dobbelstenen je opnieuw wilt gooien.]]></string>
  <string id="id_ui_howtoplay_roll_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Om een aantal dobbelstenen opnieuw te gooien, klik je eerst op de dobbelstenen die je wilt laten liggen. Klik vervolgens op de beker of de Gooien-knop. Hierdoor gooi je met de ongeselecteerde dobbelstenen en de geselecteerde dobbelstenen blijven liggen.]]></string>
  <string id="id_ui_howtoplay_roll_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Je kunt maximaal 3x per ronde met de dobbelstenen gooien.]]></string>
  <string id="id_ui_howtoplay_tips_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[<i><b>TIPS</b></i>]]></string>
  <string id="id_ui_howtoplay_tips_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Probeer allereerst de hoogste punten (onderste helft) in te vullen. Als je al vroeg 5 enen gooit, kun je beter YAHTZEE invullen (50 punten) dan enen (slechts 5 punten). Je kunt Chance, enen en tweeën gebruiken als score voor een slechte worp. Later kun je dat weer goedmaken.]]></string>
  <string id="id_ui_howtoplay_tips_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Omdat je een bonus kunt halen van 35 punten als je meer dan 63 punten scoort, kan het handig zijn om een Carré van vieren, vijven of zessen op de bovenste helft in te vullen.]]></string>
  <string id="id_ui_howtoplay_tips_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Ga door voor de Grote straat als je een Kleine straat gooit met je eerste worp en alleen nog maar een 1 of een 6 nodig hebt. De kans om een 1 of een 6 te gooien in de volgende twee worpen is groter dan je denkt!]]></string>
  <string id="id_ui_howtoplay_tips_text4" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Ga voor de YAHTZEE, maar zorg ervoor dat je iets kunt invullen op de bovenste helft als het niet lukt. Voorkom dat je een 0 moet opschrijven bij YAHTZEE als het kan.]]></string>
  <string id="id_ui_howtoplay_tips_text5" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[De beste categorie is Chance. Probeer Chance zo lang mogelijk open te houden voor de onvermijdelijke slechte worp. Je kunt hem in ieder geval gebruiken om te voorkomen dat je een 0 moet noteren bij de hoge scores, zoals Grote straat of YAHTZEE.]]></string>
  <string id="id_ui_endgame_title_Win_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Bloedstollende wedstrijd!</i>]]></string>
  <string id="id_ui_endgame_title_Win_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Je hebt gewonnen!</i>]]></string>
  <string id="id_ui_endgame_title_WinChamp_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Gefeliciteerd!</i>]]></string>
  <string id="id_ui_endgame_title_WinChamp_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Je bent de nieuwe<br>YAHTZEE-kampioen!</i>]]></string>
  <string id="id_ui_endgame_title_Lose_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Niet zo sip, laten we</i>]]></string>
  <string id="id_ui_endgame_title_Lose_Line2" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>nog een wedstrijdje spelen!</i>]]></string>
  <string id="id_popup_tutorial_desc_Turn2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Als je tevreden bent met je worp, vul dan een categorie in.<br><br>Anders kun je nog een derde keer gooien.</b>]]></string>
  <string id="id_ui_loading_building" fontName="fntCalibri" fontSize="18" charSpace="0" lineSpace="0" catID="0"><![CDATA[Optimaliseren...$value$]]></string>
