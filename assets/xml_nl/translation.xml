  <string id="id_ui_popup_feedback_WinSolo_text" fontName="fntHoboStd" fontSize="30" charSpace="0" lineSpace="0" catID="12"><![CDATA[<i><b>Goed gespeeld!</b></i>]]></string>
  <string id="id_ui_endgame_title_WinSolo_Line1" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Geweldige score!</i>]]></string>
  <string id="id_ui_endgame_title_WinSolo_Line2" fontName="fntHoboStd" fontSize="12" charSpace="0" lineSpace="0" catID="3"><![CDATA[<i>Probeer de volgende keer hoger te scoren!</i>]]></string>
  <string id="id_popup_tutorial_desc_WildDie" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Je hebt een dolle dobbelsteen!<br><br>Een dolle dobbelsteen elk aantal ogen vervangen. Zorg ervoor dat je een combinatie maakt met andere stenen die je wilt gebruiken als je op een categorie klikt om je score in te noteren.</b>]]></string>
