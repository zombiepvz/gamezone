  <string id="id_ui_title_tooltip_copyright" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="0" catID="1"><![CDATA[<b>YAHTZEE is een handelsmerk van Hasbro en wordt gebruikt met goedkeuring. ©2011 Hasbro. Alle rechten voorbehouden.</b>]]></string>
  <string id="id_ui_hud_display_name2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="5"><![CDATA[<b><i>$value$</i></b>]]></string>
  <string id="id_popup_tutorial_desc_Round3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Je krijgt de slag te pakken!<br><br>Blijf gooien en probeer zo hoog mogelijk te scoren. Niet alleen in elke ronde, maar in het hele spelletje.</b>]]></string>
  <string id="id_popup_tutorial_desc_BonusYahtzee" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="14"><![CDATA[<b>Je hebt een bonusYAHTZEE gescoord!<br><br>Elke extra YAHTZEE die je gooit, levert je 100 extra punten op. Daarnaast kun je deze worp ook gebruiken om een score in te vullen op de onderste helft, als de bijbehorende categorie op de bovenste helft al is ingevuld.</b>]]></string>
  <string id="id_ui_hud_display_categoryBonus" fontName="fntCalibri" fontSize="11" charSpace="0" lineSpace="0" catID="5"><![CDATA[<b>+$value$</b>]]></string>
