<settings>
	<tracking site="zylom_FR" game="yahtzee" source="endgame"/><!-- @source can be 'endgame' or 'bar' -->
	<!-- All paths/URLs in this settings file will be considered relative, and will use (be appended to) this root path, unless they start with 'http'. -->
	<!-- This value is usually set to an absolute URL once it is known, such as 'http://www.pogo.com/games/mygame/' (without the quotes). -->
	<rootPath>assets/fr_FR/</rootPath>
	<scores>
		<header size="20" offsetX="5" offsetY="0" leading="-4" color="#006688" />
		<items verticalSpacing="0">
			<label size="14" offsetX="0" offsetY="0" color="#407087" />
			<value size="14" offsetX="0" offsetY="0" color="#407087" />
		</items>
		<summaryItem visible="false"><!-- visible can be 'true' or 'false' only. -->
			<label size="16" offsetX="0" offsetY="0" color="#ffffff" />
			<value size="16" offsetX="0" offsetY="0" color="#ffffff" />
		</summaryItem>
	</scores>
