	<pogoInfo>
		<upsell enabled="false">
			<header size="16" offsetX="0" offsetY="0" leading="0" color="#407087"><![CDATA[Pourquoi jouer sur Pogo ?]]></header>
			<copy size="12" width="190" offsetX="0" offsetY="0"	leading="3" color="#407087" indent="-10" blockIndent="10" tabStops="[10]"><![CDATA[<p><font color="#ff9600">&gt;</font>&#9;Sauvegarder vos meilleurs scores</p><p><font color="#ff9600">&gt;</font>&#9;Jouer contre vos amis</p><p><font color="#ff9600">&gt;</font>&#9;Remporter des cadeaux</p><p><font color="#ff9600">&gt;</font>&#9;Discuter en jouant</p>]]></copy>
