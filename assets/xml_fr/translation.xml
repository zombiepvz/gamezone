  <string id="id_ui_howtoplay_goal_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[La partie se joue sur 13 manches. À chaque manche, vous lancez les dés et marquez votre résultat dans l'une des 13 catégories. Vous devez remplir chaque catégorie, ce qui signifie vous devrez parfois marquer un zero dans certaines categories si vous ne parvenez pas à obtenir certaines des combinaisons.]]></string>
  <string id="id_ui_howtoplay_goal_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Le but du jeu est d'obtenir le meilleur score total. La partie se termine quand toutes les 13 catégories ont été remplies.]]></string>
  <string id="id_ui_howtoplay_goal_Title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[%3Ci%3E%3Cb%3EBUT%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_roll_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[%3Ci%3E%3Cb%3ELANCER%20LES%20DÉS%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_roll_text1" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Lancez%20les%20cinq%20dés%20en%20cliquant%20sur%20le%20gobelet%20du%20côté%20droit%20de%20l'écran%20ou%20sur%20le%20bouton%20Lancer%20ci-dessous.%20Après%20avoir%20lancé%20les%20dés,%20vous%20pouvez%20noter%20le%20résultat%20actuel%20ou%20relancer%20entre%20un%20et%20cinq%20dés.]]></string>
  <string id="id_ui_howtoplay_roll_text2" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Pour relancer certains dés, cliquez d'abord sur les dés que vous voulez garder, puis cliquez une nouvelle fois sur le gobelet ou le bouton Lancer. Ainsi, les dés non sélectionnés seront relancés, sans modifier les dés sélectionnés.]]></string>
  <string id="id_ui_howtoplay_roll_text3" fontName="fntCalibri" fontSize="16" charSpace="0" lineSpace="0" catID="2"><![CDATA[Vous%20pouvez%20relancer%20les%20dés%20jusqu'à%20trois%20fois%20maximum%20par%20manche.%20]]></string>
  <string id="id_ui_howtoplay_tips_title" fontName="fntHoboStd" fontSize="18" charSpace="0" lineSpace="0" catID="2"><![CDATA[%3Ci%3E%3Cb%3EASTUCES%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_tips_text1" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="0" catID="2"><![CDATA[Essayez de compléter les catégories qui vous rapporteront beaucoup de points dans la partie inférieure de la feuille de score. Si vous obtenez 5 As, notez-les dans la catégorie YAHTZEE pour 50 points plutôt que dans la catégorie As pour 5 points. N'oubliez pas que vous pouvez compléter Chance, As et Deux si vous avez obtenu un mauvais lancer ; vous ferez mieux la prochaine fois.]]></string>
  <string id="id_ui_howtoplay_tips_text2" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="0" catID="2"><![CDATA[Si vous obtenez un Carré avec des 4, 5 ou 6, il peut être préférable de compléter la partie supérieure correspondante de votre feuille de score, au lieu de la catégorie Carré dans la partie inférieure, et cela en raison du bonus de 35 points accordé pour l'obtention de 63 points ou plus dans la partie supérieure de la feuille de score.]]></string>
  <string id="id_ui_howtoplay_tips_text3" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="0" catID="2"><![CDATA[Essayez%20d'obtenir%20une%20Grande%20suite%20si%20vous%20tirez%20une%20Petite%20suite%20dès%20votre%20premier%20lancer%20et%20s'il%20vous%20manque%20uniquement%20un%201%20ou%20un%206%20pour%20la%20compléter.%20La%20probabilité%20d'obtenir%20un%201%20ou%20un%206%20lors%20de%20vos%20deux%20prochains%20lancers%20est%20bien%20supérieure%20à%20ce%20que%20vous%20croyez%21]]></string>
  <string id="id_ui_howtoplay_tips_text4" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="0" catID="2"><![CDATA[Essayez%20d'obtenir%20des%20YAHTZEE,%20mais%20assurez-vous%20de%20ne%20pas%20avoir%20complété%20la%20catégorie%20correspondante%20dans%20la%20partie%20supérieure%20si%20vous%20ne%20parvenez%20pas%20à%20en%20obtenir.%20Si%20possible,%20évitez%20de%20marquer%20un%200%20dans%20la%20catégorie%20YAHTZEE%21]]></string>
