  <string id="id_ui_howtoplay_goal_text1" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Das%20Spiel%20besteht%20aus%2013%20Runden.%20In%20jeder%20Runde%20wird%20gewürfelt%20und%20die%20Augenzahl%20dann%20in%20einer%20der%2013%20Kategorien%20notiert.%20Sie%20müssen%20einmal%20in%20jeder%20Kategorie%20notieren.%20Das%20bedeutet,%20dass%20Sie%20eine%20Null%20in%20manchen%20Kategorien%20eintragen%20müssen,%20wenn%20es%20Ihnen%20nicht%20gelingt,%20gültige%20Kombinationen%20zu würfeln.]]></string>
  <string id="id_ui_howtoplay_goal_text2" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Das%20Ziel%20des%20Spiels%20ist%20es,%20Ihre%20Gesamtpunktzahl%20zu%20maximieren.%20Das%20Spiel%20endet,%20sobald%20in%20allen%2013%20Kategorien%20eingetragen%20wurde.]]></string>
  <string id="id_ui_howtoplay_goal_Title" fontName="fntHoboStd" fontSize="16" charSpace="0" lineSpace="-2" catID="2"><![CDATA[%3Ci%3E%3Cb%3EZIEL%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_roll_title" fontName="fntHoboStd" fontSize="16" charSpace="0" lineSpace="-2" catID="2"><![CDATA[%3Ci%3E%3Cb%3EWÜRFELN%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_roll_text1" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Sie%20würfeln%20mit%20allen%20fünf%20Würfeln,%20wenn%20Sie%20auf%20den%20Becher%20rechts%20im%20Bildschirm%20oder%20auf%20Würfeln%20darunter%20klicken.%20Nach%20dem%20Wurf%20können%20Sie entweder%20das%20aktuelle%20Ergebnis%20notieren%20oder%20erneut%20würfeln%20(einer bis%20fünf%20Würfel).]]></string>
  <string id="id_ui_howtoplay_roll_text2" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Um mit einigen der Würfel erneut zu würfeln, klicken Sie zuerst auf den Würfel, den Sie behalten möchten und dann erneut auf den Becher oder auf Würfeln. So werden die nicht ausgewählten Würfel erneut gewürfelt und die ausgewählten bleiben bestehen.]]></string>
  <string id="id_ui_howtoplay_roll_text3" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Sie%20können%20pro%20Runde%20höchstens%20dreimal%20würfeln.%20]]></string>
  <string id="id_ui_howtoplay_tips_title" fontName="fntHoboStd" fontSize="16" charSpace="0" lineSpace="-2" catID="2"><![CDATA[%3Ci%3E%3Cb%3ETIPPS%3C/b%3E%3C/i%3E]]></string>
  <string id="id_ui_howtoplay_tips_text1" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Versuchen%20%20Sie%20schon%20früh%20im%20Spiel%20die%20Kategorien%20mit%20hoher%20Punktzahl%20auf%20der%20unteren%20Hälfte%20der%20Punktekarte%20zu%20füllen.%20Fünf%20Einser%20früh%20im%20Spiel%20sind%20bei%20einem%20%20YAHTZEE%20mit%2050%20Punkten%20besser%20angelegt,%20als%20in%20Einsern%20mit%20nur%205%20Punkten.%20Denken%20Sie%20daran,%20Chance,%20Asse%20oder%20Zweien%20zu%20benutzen,%20um%20einen%20schlechten%20Wurf zu%20notieren%20und dann%20später%20aufholen%20.]]></string>
  <string id="id_ui_howtoplay_tips_text2" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Es%20kann%20von%20Vorteil%20sein,%20vier%20gleiche%20Zahlen%20in%20der%20oberen%20Hälfte%20zu%20notieren,%20wenn%20Sie%20Vieren,%20Fünfen%20oder%20Sechsen%20würfeln,%20denn%20es%20gibt%20einen%2035-Punkte-Bonus,%20wenn%20Sie%20mindestens%2063%20Punkte%20in%20der%20oberen%20Hälfte%20der%20Punktekarte%20notieren.]]></string>
  <string id="id_ui_howtoplay_tips_text3" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Arbeiten%20Sie%20auf%20eine%20Große%20Straße%20hin,%20wenn%20Sie%20beim%20ersten%20Wurf%20eine%20Kleine%20Straße%20erzielen.%20Sie%20brauchen%20nur%20noch%20eine%201%20oder%206,%20um%20sie%20zu%20vervollständigen.%20Die%20Wahrscheinlichkeit,%20eine%201%20oder%206%20in%20einem%20Ihrer%20nächsten%20beiden%20Würfe%20zu%20bekommen,%20ist%20größer%20als%20Sie%20denken%21]]></string>
  <string id="id_ui_howtoplay_tips_text4" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Arbeiten%20Sie%20auf%20YAHTZEEs%20hin,%20aber%20achten%20Sie%20darauf,%20dass%20die%20entsprechende%20obere%20Hälfte%20der%20Kategorie%20noch%20frei%20ist,%20um%20Sie%20aufzufangen,%20wenn%20Sie%20es%20nicht%20schaffen.%20Vermeiden%20Sie%20es,%20wenn%20möglich,%20eine%200%20für%20einen%20YAHTZEE%20zu%20notieren%21]]></string>
  <string id="id_ui_howtoplay_tips_text5" fontName="fntCalibri" fontSize="14" charSpace="0" lineSpace="-2" catID="2"><![CDATA[Die%20beste%20Kategorie%20auf%20der%20Karte%20ist%20Chance.%20Versuchen%20Sie,%20sie%20so%20lange%20wie%20möglich%20freizuhalten,%20um%20den%20unvermeidbaren%20schlechten%20Wurf%20zu%20verkraften.%20Nicht%20zuletzt%20können%20Sie%20sie%20nutzen,%20um%20keine%20Null%20in%20höheren Wert-Kategorien%20notieren%20zu%20müssen,%20wie%20zum%20Beispiel%20der%20Großen%20Straße%20oder%20dem%20YAHTZEE.]]></string>
